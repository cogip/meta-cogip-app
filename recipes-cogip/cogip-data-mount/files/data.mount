[Unit]
Description=Cogip persistent data partition
# Created by wic with label "data". Holds the Docker data-root, the
# on-device source for VSCode editing, and runtime records.

[Mount]
What=/dev/disk/by-label/data
Where=/data
Type=ext4
# x-systemd.growfs: when /data is raw-copied from a pre-loaded ext4
# (cogip-sdimage-app.wks) smaller than the 8 GiB partition, grow the fs to
# fill it on first mount. No-op once already at full size.
Options=defaults,noatime,x-systemd.growfs

[Install]
WantedBy=local-fs.target
