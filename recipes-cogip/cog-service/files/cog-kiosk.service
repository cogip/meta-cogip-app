[Unit]
Description=Cog WPE WebKit kiosk
Documentation=https://github.com/Igalia/cog
# The kiosk shows a local URL (localhost), so it must NOT wait for
# network-online -- that would stall the display by the networkd
# wait-online timeout when no link is up.
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/cog-kiosk
Restart=always
RestartSec=1

# Run as root for now (Pi 4 kiosk, no multi-user). Tighten to a
# dedicated `kiosk` user once the unit is stable.
User=root

# DRM/KMS direct: Cog opens /dev/dri/card0 itself (no compositor, no
# logind seat). Own tty1 so it is the foreground VT / DRM master.
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
