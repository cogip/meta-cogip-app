# Cogip runtime environment, shared by every cogip@ tool service.
# @ROBOT_ID@ and @COMPOSE_PROFILES@ are substituted at image build time
# from the ROBOT_ID build variable (0 = beacon, 1-5 = robot).
#
# Per-deployment tuning (robot geometry, lidar thresholds, ...) is left
# commented; fill in per device or via a /data override drop-in.

# General
ROBOT_ID=@ROBOT_ID@
COMPOSE_PROFILES=@COMPOSE_PROFILES@
COGIP_SOCKETIO_SERVER_URL=http://localhost:809@ROBOT_ID@

# Copilot / CAN (real socketcan interface on the Pi, not vcan)
COPILOT_CAN_CHANNEL=can0
#COPILOT_CAN_BITRATE=500000
#COPILOT_CANFD_DATA_BITRATE=1000000

# Planner (fill per robot)
#PLANNER_ROBOT_WIDTH=
#PLANNER_ROBOT_LENGTH=
#PLANNER_OBSTACLE_BB_MARGIN=
PLANNER_BYPASS_DETECTOR=0

# Detector / lidar (fill per robot)
#DETECTOR_LIDAR_PORT=/dev/ttyAMA0
#DETECTOR_MIN_DISTANCE=
#DETECTOR_MAX_DISTANCE=

# MCU logger
MCU_LOGGER_PORT=/dev/ttyAMA2

# Cameras (Raspberry Pi Global Shutter defaults)
ROBOTCAM_NAME=rpicam
ROBOTCAM_CODEC=yuyv
ROBOTCAM_WIDTH=728
ROBOTCAM_HEIGHT=544
CAMERA_NAME=rpicam
CAMERA_CODEC=yuyv
CAMERA_WIDTH=728
CAMERA_HEIGHT=544
