[Unit]
Description=Cogip tool %i (native)
# Native: the tool runs directly on the system Python 3.14 (cogip-tools +
# its deps installed in site-packages), no Docker. The instance name is the
# tool name, matching the cogip-%i console script (e.g. cogip@planner ->
# /usr/bin/cogip-planner). Per-role config from cogip-environment.
After=network.target
PartOf=cogip.target

[Service]
Type=simple
EnvironmentFile=/etc/cogip/environment
ExecStart=/usr/bin/cogip-%i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=cogip.target
