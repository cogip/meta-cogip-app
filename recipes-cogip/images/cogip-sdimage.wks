# short-description: Cogip kiosk SD card image (boot + root + data)
# long-description: Three-partition layout for the Raspberry Pi 4 kiosk:
#   - boot : VFAT firmware + kernel (meta-raspberrypi bootimg-partition)
#   - root : ext4 Yocto rootfs (kept lean, can go read-only / RAUC later)
#   - data : ext4 persistent partition for Docker storage (/data/docker),
#            the on-device source for VSCode editing and runtime records.
# Based on meta-raspberrypi/wic/sdimage-raspberrypi.wks.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 100
part /     --source rootfs            --ondisk mmcblk0 --fstype=ext4 --label root --align 4096
part /data                            --ondisk mmcblk0 --fstype=ext4 --label data --align 4096 --fixed-size 8192
